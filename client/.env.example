# Copy this file to .env and fill in YOUR OWN values. Never commit .env.

# "sepolia" (default) or "localhost" to test against `npx hardhat node`
VITE_APP_CHAIN=sepolia
# Local launcher only. Keep false for Sepolia and every deployed environment.
VITE_ENABLE_DEMO_WALLET=false
# Your own Sepolia RPC URL (Alchemy / Infura). Optional: a public one is used if blank.
VITE_APP_RPC_URL=
VITE_APP_EXPLORER_URL=https://sepolia.etherscan.io

# Free project id from https://cloud.reown.com (needed for the wallet connect modal)
VITE_APP_APPKIT_PROJECT_ID=

# Printed by `npm run deploy:sepolia` in the contract folder
VITE_APP_KYC_MANAGER_ADDRESS=
VITE_APP_CONTRACT_ADDRESS=
# Block number printed by the deploy script (speeds up reading donation history)
VITE_APP_DEPLOY_BLOCK=0

# Optional: image upload for campaigns (your own Cloudinary account).
# When omitted on localhost, the Node service stores public campaign images locally.
# Example URL: https://api.cloudinary.com/v1_1/<your-cloud-name>/image/upload
VITE_APP_CLOUDINARY_URL=
VITE_APP_CLOUDINARY_PRESET=

# Optional: URL of the fraud-detection service (fraud/service). Leave empty to hide risk scores.
# On localhost this service also stores demo KYC images when Cloudinary is not configured.
VITE_FRAUD_API_URL=http://localhost:4000

# Backend-only (set on the Node service, never expose with a VITE_ prefix):
# DATA_ENCRYPTION_KEY=<long random secret>
