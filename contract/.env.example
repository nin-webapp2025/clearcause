# Copy to .env and fill in YOUR OWN values. Never commit .env or share it.
# Free RPC URL from Alchemy / Infura / similar (Sepolia network)
SEPOLIA_RPC_URL=
# Private key of a THROWAWAY test wallet that only holds Sepolia test ETH.
# Never use a wallet that holds real funds.
PRIVATE_KEY=
# Optional: lets the deploy script verify the source code on Etherscan
ETHERSCAN_API_KEY=
# Optional: governance quorum, in votes (1 vote = 1 donation receipt NFT)
QUORUM_VOTES=3
